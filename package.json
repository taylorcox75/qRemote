{
  "name": "qRemote",
  "version": "3.9.01",
  "easBuild": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "simulator": "npx expo run:ios --device \"iPhone 17e\"",
    "xcode": "npm install && npx expo prebuild -p ios && cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install && cd .. && open ios/qRemote.xcworkspace",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write '**/*.{ts,tsx,js,json}'",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-updates": "~58.0.21",
    "i18next": "^26.3.6",
    "intl-pluralrules": "^2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^14.0.1"
    },
    "glob@>=9.0.0": "^14.0.2",
    "minimatch@>=7.0.0": "^11.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "expo-dev-client": true
  }
}

